# ---------- Core ----------
PORT=4000
# Where the frontend (React app) runs - used in reminder links and allowed by CORS
FRONTEND_URL=http://localhost:5173
# Public address of this API - used for Google/Twilio webhooks (must be https for Google push)
API_URL=http://localhost:4000
# Browser origins allowed to call the API (comma separated). Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173
# Therapist login
ADMIN_EMAIL=therapist@example.com
ADMIN_PASSWORD=change-me
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Practice timezone (IANA name). Defaults to the server's timezone.
PRACTICE_TIMEZONE=Asia/Karachi

# ---------- MySQL ----------
# The database and tables are created automatically on first start.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=therapy_scheduler

# ---------- Google Calendar ----------
# OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <API_URL>/api/public/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/public/google/callback
# Backup polling interval (seconds) - catches anything push notifications missed
GOOGLE_POLL_SECONDS=60

# ---------- Email (SMTP) ----------
# Leave empty for demo mode (messages are logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dr. Practice <no-reply@example.com>"

# ---------- SMS / WhatsApp (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
